    "ia_goal": "为高密度性能分析工作流定义清晰的信息架构与页面结构"
  },
  "product_principles": [
    "分析效率优先于装饰性视觉",
    "高密度但层级清晰",
    "默认暗黑模式",
    "表格、图表、时间线共同构成主工作区",
    "自然语言查询作为导航入口，不替代专业视图"
  ],

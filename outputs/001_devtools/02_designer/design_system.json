{
  "meta": {
    "product_name": "PerfScope",
    "version": "1.0",
    "theme_name": "Precision Console",
    "product_type": "high-density devtools",
    "mode": "dark-first"
  },
  "design_principles": [
    "analysis efficiency over decorative novelty",
    "high density with explicit hierarchy",
    "shared shell and linked views over isolated cards",
    "semantic accent colors only",
    "short, reversible interactions",
    "evidence-first query experience"
  ],
  "anti_patterns_to_avoid": [
    "purple-blue tech gradients as default background",
    "full-screen glassmorphism cards",
    "template dashboard layout with generic KPI blocks",
    "heavy neumorphism on large surfaces",
    "background effects that compete with data"
  ],
  "theme": {
    "background": {
      "base": "#0B0F14",
      "elevated": "#10161D",
      "panel": "#131A22",
      "panel_alt": "#161F29",
      "overlay": "#0F141BCC",
      "canvas_grid": "#202B36",
      "canvas_axis": "#334150"
    },
    "text": {
      "primary": "#E6EDF3",
      "secondary": "#A9B4C0",
      "muted": "#7E8A97",
      "inverse": "#0B0F14",
      "disabled": "#5F6B77"
    },
    "border": {
      "subtle": "#25303A",
      "default": "#2F3C48",
      "strong": "#425364",
      "focus": "#58C4DD"
    },
    "accent": {
      "info": "#58C4DD",
      "success": "#7FD46B",
      "warning": "#F1B84B",
      "danger": "#FF6B57",
      "highlight": "#C7F36B",
      "selection": "#2A6C8E"
    },
    "severity": {
      "critical": "#FF6B57",
      "high": "#F1B84B",
      "medium": "#58C4DD",
      "low": "#7E8A97"
    },
    "chart": {
      "series_1": "#58C4DD",
      "series_2": "#C7F36B",
      "series_3": "#F1B84B",
      "series_4": "#FF8A65",
      "series_5": "#8FA8FF",
      "grid": "#23303C",
      "crosshair": "#D7E3EE",
      "selection_fill": "#58C4DD22",
      "selection_stroke": "#58C4DD"
    }
  },
  "typography": {
    "font_family_ui": "\"IBM Plex Sans\", \"Segoe UI\", sans-serif",
    "font_family_mono": "\"JetBrains Mono\", \"SFMono-Regular\", monospace",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "sizes": {
      "caption": 11,
      "label": 12,
      "body_sm": 13,
      "body_md": 14,
      "body_lg": 16,
      "title_sm": 18,
      "title_md": 22,
      "title_lg": 28,
      "metric": 30
    },
    "line_heights": {
      "compact": 1.3,
      "default": 1.45,
      "reading": 1.6
    },
    "letter_spacing": {
      "tight": -0.02,
      "normal": 0,
      "wide_label": 0.04
    }
  },
  "spacing": {
    "grid_unit": 4,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32
  },
  "radius": {
    "control": 8,
    "panel": 12,
    "overlay": 14,
    "pill": 999
  },
  "stroke": {
    "hairline": 1,
    "emphasis": 1.5,
    "divider": 1
  },
  "shadow": {
    "panel": "0 8px 24px rgba(0,0,0,0.28)",
    "overlay": "0 16px 40px rgba(0,0,0,0.42)",
    "focus_glow": "0 0 0 3px rgba(88,196,221,0.18)",
    "soft_control": "inset 0 1px 0 rgba(255,255,255,0.04), 0 1px 2px rgba(0,0,0,0.24)"
  },
  "layout": {
    "app_shell": {
      "sidebar_width": 248,
      "topbar_height": 56,
      "right_panel_width": 360,
      "content_max_width": 1920
    },
    "content_padding": {
      "x": 16,
      "y": 12
    },
    "panel_gaps": 12,
    "density_modes": {
      "compact": {
        "row_height": 32,
        "toolbar_height": 36,
        "card_padding": 12
      },
      "comfortable": {
        "row_height": 40,
        "toolbar_height": 44,
        "card_padding": 16
      }
    }
  },
  "interaction": {
    "focus_ring_color": "#58C4DD",
    "hover_fill": "#FFFFFF08",
    "pressed_fill": "#FFFFFF10",
    "selected_fill": "#58C4DD1A",
    "selected_border": "#58C4DD",
    "disabled_opacity": 0.42
  },
  "motion": {
    "duration_fast_ms": 120,
    "duration_base_ms": 160,
    "duration_slow_ms": 220,
    "easing_standard": "cubic-bezier(0.2, 0, 0, 1)",
    "easing_emphasis": "cubic-bezier(0.16, 1, 0.3, 1)",
    "principles": [
      "use motion to clarify state changes",
      "avoid perpetual decorative loops",
      "prefer opacity and transform",
      "respect reduced motion"
    ]
  },
  "iconography": {
    "style": "outlined with occasional filled severity markers",
    "stroke_width": 1.75,
    "recommended_sets": [
      "Lucide",
      "Heroicons"
    ]
  },
  "data_visualization_rules": {
    "default_grid_visibility": "subtle",
    "crosshair_behavior": "show on hover and brush only",
    "trend_animation": "disabled by default for dense charts",
    "status_encoding": [
      "color",
      "label",
      "shape"
    ],
    "table_alignment": {
      "numbers": "right",
      "labels": "left",
      "status": "center-left"
    }
  },
  "neumorphism_policy": {
    "allowed": true,
    "scope": [
      "segmented controls",
      "small toggles",
      "zoom controls",
      "query input focus state"
    ],
    "disallowed": [
      "full panel backgrounds",
      "metric cards",
      "data table containers",
      "timeline lanes"
    ],
    "rationale": "retain tactile cues without sacrificing information clarity"
  }
}

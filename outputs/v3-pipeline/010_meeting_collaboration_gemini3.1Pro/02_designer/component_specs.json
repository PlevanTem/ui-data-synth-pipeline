{
  "components": [
    {
      "name": "MeetingDock",
      "purpose": "底部控制栏，包含静音、视频、共享、离开",
      "variants": ["floating_desktop", "fixed_mobile"],
      "states": ["default", "hover", "active(Muted)"],
      "interaction_notes": [
        "Hover 时图标有轻微的放大反弹动效",
        "点击静音，图标变红并带有斜线画出的微动效"
      ],
      "linkage": {
        "affects": ["VideoStreamCard(更新静音状态图标)", "GenerativeBackground(若静音则流体变缓)"],
        "affected_by": [],
        "shared_state": ["isMuted", "isVideoOn"]
      }
    },
    {
      "name": "TranscriptionPanel",
      "purpose": "展示 AI 实时语音转写",
      "variants": ["sidebar", "overlay_drawer"],
      "states": ["default", "receiving_voice", "processing_summary"],
      "interaction_notes": [
        "新文字出现时，整列表平滑上滚",
        "Hover 某句话可高亮，并显示『提取为待办』的 Action Button"
      ],
      "linkage": {
        "affects": ["ActionItemList(添加新待办)"],
        "affected_by": ["MeetingDock(静音时不产生新文本)"],
        "shared_state": ["transcriptData"]
      }
    },
    {
      "name": "WhiteboardCanvas",
      "purpose": "提供跨设备协作批注",
      "variants": ["hidden", "fullscreen"],
      "states": ["default", "drawing", "erasing"],
      "interaction_notes": [
        "鼠标按下即生成平滑曲线（需进行曲线拟合）",
        "显示模拟的其他用户光标（带有姓名标签）"
      ],
      "linkage": {
        "affects": [],
        "affected_by": ["MeetingDock(点击『共享/批注』触发展示)"],
        "shared_state": ["isWhiteboardActive"]
      }
    }
  ],
  "interaction_flows": [
    {
      "trigger": "User clicks 'Leave Meeting'",
      "source_component": "MeetingDock.LeaveButton",
      "target_components": ["MeetingRoomLayout", "AISummaryView"],
      "state_changes": ["in_meeting -> post_meeting"],
      "animation": "MeetingRoomLayout 向内缩放并淡出，AISummaryView 卡片从屏幕中央展开"
    }
  ]
}
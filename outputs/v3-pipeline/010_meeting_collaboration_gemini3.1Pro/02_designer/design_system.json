{
  "design_direction": "Calm & Fluid Intelligence",
  "color_palette": {
    "background": "#F7F9FA",
    "surface": "#FFFFFF",
    "surface_elevated": "rgba(255, 255, 255, 0.8)",
    "primary": "#2D3748",
    "primary_highlight": "#1A202C",
    "accent_amber": "#D97706",
    "accent_blue": "#3182CE",
    "text_main": "#1A202C",
    "text_secondary": "#718096",
    "border": "#E2E8F0"
  },
  "typography": {
    "font_family_main": "'Inter', 'SF Pro Display', sans-serif",
    "font_family_mono": "'JetBrains Mono', monospace",
    "scale": {
      "h1": "2.5rem",
      "h2": "1.75rem",
      "body": "1rem",
      "small": "0.875rem",
      "micro": "0.75rem"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px"
  },
  "radius": {
    "sm": "6px",
    "md": "12px",
    "lg": "20px",
    "pill": "9999px"
  },
  "shadow": {
    "subtle": "0 4px 20px rgba(0, 0, 0, 0.03)",
    "floating": "0 12px 40px rgba(0, 0, 0, 0.08)",
    "active": "0 0 0 2px rgba(217, 119, 6, 0.3)"
  },
  "motion": {
    "timing_functions": {
      "spatial_spring": "cubic-bezier(0.175, 0.885, 0.32, 1.1)",
      "smooth_ease": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "duration_scale": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms"
    },
    "orchestration_rules": [
      "面板入场采用从底部轻微滑入 + 淡入 (Fade in up)",
      "设备流转时，元素采用抛物线轨迹 (spatial_spring) 飞跃"
    ]
  },
  "generative_aesthetics": {
    "color_mapping": {
      "base": "#F7F9FA",
      "ripple": "#E2E8F0"
    },
    "density_range": "low",
    "noise_parameters": {
      "scale": 0.005,
      "speed": 0.2
    },
    "blend_modes": ["multiply"],
    "layer_opacity_strategy": "在背景层以 30% 左右的极低透明度运行，绝不干扰文字阅读。"
  },
  "responsive_rules": [
    "桌面端：左右双栏布局，视频流居中偏左，转写在右。",
    "平板端：转写面板变为可抽拉的 Drawer。",
    "手机端：仅显示主讲人视频，其他功能通过底部固定 Tab 切换。"
  ],
  "accessibility_rules": [
    "文字与背景对比度必须 > 4.5:1",
    "AI 转写必须支持纯文本回读，不依赖视觉特效理解"
  ]
}
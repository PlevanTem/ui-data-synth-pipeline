{
    "components": [
        {
            "name": "MeetingCard",
            "purpose": "展示日程中的单场会议，并提供一键入会入口",
            "variants": [
                "upcoming",
                "ongoing",
                "past"
            ],
            "states": [
                "default",
                "hover",
                "active"
            ],
            "interaction_notes": [
                "Hover 时有轻微上浮及表面光泽滑过",
                "点击时产生向内按压感并触发路由跳转"
            ],
            "linkage": {
                "affects": [
                    "Router view transition"
                ],
                "affected_by": [
                    "Time update (changes variant to ongoing)"
                ],
                "shared_state": [
                    "Current Meeting ID"
                ]
            },
            "motion_notes": [
                "进入视口时带交错淡入动画"
            ],
            "responsive_notes": [
                "移动端全宽，桌面端为网格布局中的单元"
            ]
        },
        {
            "name": "LiveTranslationPanel",
            "purpose": "会中提供实时转写与多语言翻译字幕",
            "variants": [
                "floating",
                "docked"
            ],
            "states": [
                "default",
                "translating",
                "error"
            ],
            "interaction_notes": [
                "允许用户拖动改变位置 (Floating variant)",
                "自动滚动到最新句子"
            ],
            "linkage": {
                "affects": [],
                "affected_by": [
                    "Mic input status",
                    "Language selection toggle"
                ],
                "shared_state": [
                    "Transcription stream"
                ]
            },
            "motion_notes": [
                "新句子平滑滑入，旧句子透明度衰减"
            ],
            "responsive_notes": [
                "移动端锁定为底部抽屉"
            ]
        }
    ],
    "interaction_flows": [
        {
            "trigger": "User clicks 'Join' on an ongoing MeetingCard",
            "source_component": "MeetingCard",
            "target_components": [
                "MeetingRoomLayout",
                "VideoGrid"
            ],
            "state_changes": [
                "Route changes to /meeting",
                "Camera/Mic activation simulation starts"
            ],
            "animation": "Card expands to fill screen (Shared Element simulation)"
        }
    ]
}
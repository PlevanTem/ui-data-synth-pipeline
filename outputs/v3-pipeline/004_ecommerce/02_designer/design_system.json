{
  "design_direction": "Liquid Glass Spatial Commerce",
  "color_palette": {
    "primary": "#3B82F6",
    "primary_glow": "rgba(59, 130, 246, 0.5)",
    "secondary": "#60A5FA",
    "accent": "#F97316",
    "background_dark": "#0F172A",
    "glass_surface": "rgba(255, 255, 255, 0.1)",
    "glass_border": "rgba(255, 255, 255, 0.2)",
    "text_primary": "#FFFFFF",
    "text_secondary": "rgba(255, 255, 255, 0.7)"
  },
  "typography": {
    "font_family": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
    "headings": {
      "weight": 600,
      "letter_spacing": "-0.02em"
    },
    "body": {
      "weight": 400,
      "line_height": 1.6
    }
  },
  "spacing": {
    "base": 4,
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "fab_bottom": "88px"
  },
  "radius": {
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "pill": "9999px"
  },
  "shadow": {
    "glass": "0 8px 32px 0 rgba(31, 38, 135, 0.37)",
    "glow": "0 0 20px rgba(59, 130, 246, 0.5)"
  },
  "motion": {
    "timing_functions": {
      "spring": "spring(stiffness=100, damping=20)",
      "ease_out": "cubic-bezier(0.25, 0.8, 0.25, 1)"
    },
    "duration_scale": {
      "fast": "200ms",
      "normal": "400ms",
      "slow": "800ms"
    }
  },
  "generative_aesthetics": {
    "noise_parameters": {
      "scale": 0.005,
      "speed": 0.2
    },
    "particle_density": "medium",
    "blend_modes": ["screen", "overlay"]
  }
}
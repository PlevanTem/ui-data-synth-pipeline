{
  "design_direction": "极简暗夜工作流 — 深石板色系 + 冰蓝强调 + AI 流式视觉语言",
  "color_palette": {
    "mode": "dual (dark primary + light secondary)",
    "dark": {
      "background": {
        "base": "#0a0f1e",
        "surface": "#111827",
        "elevated": "#1e2a3a",
        "overlay": "#243247"
      },
      "border": {
        "subtle": "#1e293b",
        "default": "#2d3f52",
        "strong": "#3d5168"
      },
      "text": {
        "primary": "#f1f5f9",
        "secondary": "#94a3b8",
        "tertiary": "#64748b",
        "disabled": "#475569"
      },
      "accent": {
        "primary": "#38bdf8",
        "primary_muted": "#1e3a4f",
        "primary_hover": "#7dd3fc",
        "success": "#34d399",
        "warning": "#fbbf24",
        "error": "#f87171",
        "ai_glow": "#38bdf840"
      }
    },
    "light": {
      "background": {
        "base": "#f8fafc",
        "surface": "#ffffff",
        "elevated": "#f1f5f9",
        "overlay": "#e2e8f0"
      },
      "border": {
        "subtle": "#e2e8f0",
        "default": "#cbd5e1",
        "strong": "#94a3b8"
      },
      "text": {
        "primary": "#0f172a",
        "secondary": "#475569",
        "tertiary": "#94a3b8",
        "disabled": "#cbd5e1"
      },
      "accent": {
        "primary": "#0284c7",
        "primary_muted": "#e0f2fe",
        "primary_hover": "#0369a1",
        "success": "#059669",
        "warning": "#d97706",
        "error": "#dc2626",
        "ai_glow": "#0284c720"
      }
    },
    "rationale": "深石板暗色减少长时会议的眼部疲劳；冰蓝作为单一强调色突出 AI 动作和主要 CTA；双主题满足 PRD 亮/暗切换需求"
  },
  "typography": {
    "font_stack": {
      "primary": "'HarmonyOS Sans', 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Consolas', monospace",
      "fallback_web": "'Inter', sans-serif"
    },
    "scale": {
      "xs": "0.75rem / 1rem",
      "sm": "0.875rem / 1.25rem",
      "base": "1rem / 1.5rem",
      "lg": "1.125rem / 1.75rem",
      "xl": "1.25rem / 1.75rem",
      "2xl": "1.5rem / 2rem",
      "3xl": "1.875rem / 2.25rem"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "transcript_specific": {
      "font_size": "0.9375rem",
      "line_height": "1.7",
      "letter_spacing": "0.01em",
      "rationale": "转写文本需要较大行高保持可读性，不压迫"
    },
    "chinese_notes": "中文字符需要至少 1.6 的行高，14px 以上基础字号"
  },
  "spacing": {
    "unit": "4px",
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "component_padding": {
      "card": "16px 20px",
      "section": "24px",
      "sidebar": "12px 16px",
      "topbar": "0 24px"
    }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "full": "9999px",
    "rationale": "鸿蒙 ArkUI 偏向中等圆角，既不过度圆润（消费品风）也不直角（过时企业风）"
  },
  "shadow": {
    "sm": "0 1px 3px rgba(0,0,0,0.3), 0 1px 2px rgba(0,0,0,0.2)",
    "md": "0 4px 12px rgba(0,0,0,0.35)",
    "lg": "0 10px 30px rgba(0,0,0,0.4)",
    "accent_glow": "0 0 20px rgba(56,189,248,0.25)",
    "card_hover": "0 8px 24px rgba(0,0,0,0.45)",
    "dark_mode_note": "暗色模式下 shadow 用更深的黑而非默认灰色，防止悬浮感丢失"
  },
  "motion": {
    "timing_functions": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring_out": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "ease_in": "cubic-bezier(0.4, 0, 1, 1)",
      "ease_out": "cubic-bezier(0, 0, 0.2, 1)",
      "linear": "linear"
    },
    "duration_scale": {
      "instant": "50ms",
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms",
      "very_slow": "800ms",
      "ai_stream_char_delay": "35ms"
    },
    "orchestration_rules": [
      "入场动画：子元素使用 stagger delay，每元素间隔 60ms，从上到下",
      "视图切换：旧视图 fade+slide-out (150ms)，新视图 fade+slide-in (250ms)",
      "侧边栏展开：spring curve，width 从 64px 到 240px",
      "纪要生成动效：粒子聚合 1500ms → 内容区域 stagger 出现 800ms",
      "状态变化（卡片 hover / 激活）：150ms ease-out，不要超过 200ms"
    ],
    "scroll_animation_strategy": "Intersection Observer 触发，margin -50px，threshold 0.15，不要全页滚动视差"
  },
  "interaction_principles": [
    "每个点击都必须有 100ms 内的视觉响应",
    "AI 正在处理时禁止多次触发，用 disabled + loading 态保护",
    "流式文字出现时，保持底部自动滚动（sticky scroll），但允许用户中断后手动滚动",
    "错误状态必须有行内提示，不要只用弹窗",
    "成功 toast 在右上角出现，3秒后自动消失",
    "所有操作都要有 hover feedback，cursor 变化",
    "移动端 tap 区域最小 44px × 44px"
  ],
  "visual_motifs": [
    "声波纹（会议进行中的 AI 活跃状态信号）",
    "冰蓝光晕（AI 生成内容的轻微光效）",
    "流式文字涌现（打字机效果 + opacity 渐变）",
    "发言脉冲圆（参会者头像的状态可视化）",
    "模块边界线（清晰但低对比度，1px border）"
  ],
  "generative_aesthetics": {
    "color_mapping": {
      "waveform_bars": "#38bdf8 with opacity 0.6-1.0",
      "particles_start": "#38bdf8 opacity 0.8",
      "particles_end": "#f1f5f9 opacity 0.95",
      "pulse_ring": "#38bdf8 opacity 0.3 → 0"
    },
    "density_range": {
      "waveform_bars": "32-48 bars",
      "particles_count": "80-120 particles"
    },
    "noise_parameters": {
      "waveform": "simplex noise, octaves=2, frequency=0.015",
      "particle_movement": "brownian motion, speed=1-3px/frame"
    },
    "motion_speed_range": {
      "waveform_update": "60fps smooth",
      "particle_convergence": "1500ms total, ease-in-out"
    },
    "blend_modes": ["screen", "overlay (sparingly)"],
    "layer_opacity_strategy": "生成式层最大不超过 0.7 opacity，保证文字可读性优先"
  },
  "illustration_strategy": {
    "style": "线性图标 + 功能性插图（非装饰性）",
    "icon_set": "Phosphor Icons 或 HarmonyOS 风格线性图标",
    "empty_state_illustrations": "抽象线条 + 功能场景简笔画，不使用卡通人物",
    "device_icons": "手机/平板/智慧屏的轮廓图，用于设备切换标签"
  },
  "depth_strategy": {
    "layers": [
      "Layer 0 (base): 页面背景色 #0a0f1e",
      "Layer 1 (surface): 主内容卡片 #111827",
      "Layer 2 (elevated): 悬浮卡片/Tooltip #1e2a3a",
      "Layer 3 (overlay): Modal/Drawer 背景 + 前景 #243247",
      "Layer 4 (toast): 全局 Toast #2d3f52"
    ],
    "generative_layer": "位于 Layer 0-1 之间，canvas 元素 z-index: -1，pointer-events: none"
  },
  "responsive_rules": [
    "桌面 ≥1280px：侧边导航 240px 固定宽，双栏主内容区，转写+摘要并排",
    "平板 768-1279px：侧边导航折叠为 64px 图标模式，主内容单栏，摘要抽屉式",
    "手机 <768px：底部 Tab 导航替代侧边栏，全屏单栏，FAB 快捷操作"
  ],
  "accessibility_rules": [
    "文字对比度：主文字 ≥7:1（AAA），次要文字 ≥4.5:1（AA）",
    "焦点可见：focus ring 2px solid #38bdf8，offset 2px",
    "动画：prefers-reduced-motion 时关闭所有 canvas 动效和过渡动画",
    "图标按钮：必须有 aria-label",
    "颜色不能是唯一信息载体：状态变化同时使用颜色+图标+文字"
  ]
}

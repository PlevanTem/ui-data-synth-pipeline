{
  "component_library": [
    {
      "name": "DeviceCard",
      "type": "interactive",
      "description": "设备控制卡片，核心 UI 单元",
      "variants": ["lighting", "climate", "security", "entertainment", "curtain", "appliance"],
      "states": ["on", "off", "offline", "executing"],
      "visual_spec": {
        "size": "minmax(160px, 1fr)",
        "background_off": "rgba(255,255,255,0.04)",
        "background_on": "device_type_glow_gradient",
        "border_on": "1px solid rgba(device_glow_color, 0.40)",
        "border_off": "1px solid rgba(255,255,255,0.08)",
        "glow_on": "box-shadow: 0 0 20px device_glow_color",
        "radius": "20px",
        "padding": "16px"
      },
      "controls_by_type": {
        "lighting": ["power_toggle", "brightness_slider"],
        "climate": ["power_toggle", "temp_up_down", "mode_chip_group"],
        "security": ["power_toggle", "status_badge"],
        "entertainment": ["power_toggle", "volume_control"],
        "curtain": ["open_close_toggle", "position_slider"],
        "appliance": ["power_toggle", "mode_chip_group"]
      },
      "animation": {
        "on_transition": "background 180ms ease-out, box-shadow 300ms ease",
        "icon_pulse": "glow pulse 2s ease-in-out infinite when on"
      }
    },
    {
      "name": "SceneCard",
      "type": "interactive",
      "description": "场景快捷触发卡片",
      "states": ["idle", "active", "executing"],
      "visual_spec": {
        "background_active": "scene_color_bg",
        "background_idle": "rgba(255,255,255,0.04)",
        "border_active": "1px solid rgba(scene_color, 0.40)",
        "icon_size": "32px",
        "label": "场景名称",
        "active_indicator": "left-border 3px solid scene_color + check badge"
      },
      "executing_animation": "ripple_expand + stagger_device_states"
    },
    {
      "name": "RoomTab",
      "type": "navigation",
      "description": "房间选择标签",
      "states": ["active", "inactive"],
      "visual_spec": {
        "active_bg": "rgba(78,158,255,0.15)",
        "active_border": "1px solid rgba(78,158,255,0.40)",
        "active_text": "#4E9EFF",
        "inactive_bg": "transparent",
        "radius": "full",
        "padding": "6px 14px",
        "icon": "room_icon",
        "transition": "150ms ease"
      }
    },
    {
      "name": "StatCard",
      "type": "display",
      "description": "仪表盘统计数字卡片",
      "variants": ["devices_online", "active_scene", "energy_today"],
      "visual_spec": {
        "hero_number": "3.5rem font-weight:700",
        "unit": "0.875rem text-secondary",
        "label": "0.75rem text-tertiary",
        "background": "rgba(255,255,255,0.05)",
        "trend_indicator": "arrow + percentage color-coded"
      },
      "animation": {
        "number_entrance": "countUp 600ms ease-out"
      }
    },
    {
      "name": "VoiceOverlay",
      "type": "modal_overlay",
      "description": "语音控制浮层",
      "states": ["idle", "listening", "processing", "success", "error"],
      "visual_spec": {
        "backdrop": "blur(40px) bg(0D0F14 85%)",
        "waveform": "Canvas particle/waveform animation",
        "transcript_text": "streaming reveal animation",
        "result_state": "icon + text feedback",
        "radius": "32px (bottom sheet on mobile)"
      },
      "animation": {
        "listening": "pulsing waveform particles, mic icon pulse",
        "processing": "spinner + dots animation",
        "success": "checkmark scale in + green glow",
        "error": "shake animation + red tint"
      }
    },
    {
      "name": "EnergyChart",
      "type": "data_visualization",
      "description": "能耗统计图表",
      "chart_types": ["bar_chart_by_device", "area_chart_trend", "donut_distribution"],
      "visual_spec": {
        "color_encoding": {
          "low_consumption": "#34D399",
          "medium_consumption": "#FBBF24",
          "high_consumption": "#FF5C5C"
        },
        "bar_radius": "6px top corners",
        "tooltip": "glass morphism card",
        "grid_lines": "rgba(255,255,255,0.06)"
      },
      "animation": {
        "bar_entrance": "scaleY from 0, stagger 80ms per bar",
        "area_entrance": "draw path + fill fade",
        "tooltip": "fade + scale 150ms"
      }
    },
    {
      "name": "DeviceDetailDrawer",
      "type": "overlay",
      "description": "设备详情侧边抽屉",
      "visual_spec": {
        "width": "380px (desktop) / 100% bottom sheet (mobile)",
        "background": "rgba(22,25,33,0.95) blur(24px)",
        "device_illustration": "large device icon with ambient glow",
        "sections": ["基本信息", "精细控制", "能耗数据", "使用历史"],
        "close_gesture": "swipe down / click outside"
      },
      "animation": {
        "entrance": "slide from right 280ms cubic-bezier(0.32,0.72,0,1)",
        "exit": "slide to right 200ms ease-in"
      }
    },
    {
      "name": "ToastNotification",
      "type": "feedback",
      "description": "操作结果通知",
      "variants": ["success", "error", "info", "loading"],
      "visual_spec": {
        "position": "top-right (desktop) / top-center (mobile)",
        "background": "glass morphism surface",
        "icon": "status icon with color coding",
        "max_width": "360px"
      },
      "animation": {
        "in": "240ms cubic-bezier(0.34, 1.56, 0.64, 1) slide + spring",
        "out": "160ms ease-in slide + fade"
      }
    },
    {
      "name": "SkeletonLoader",
      "type": "loading",
      "description": "骨架屏加载占位",
      "variants": ["device_card", "stat_card", "scene_card", "chart"],
      "visual_spec": {
        "base_color": "rgba(255,255,255,0.04)",
        "shimmer_color": "rgba(255,255,255,0.08)",
        "shimmer_animation": "linear 1500ms infinite left-to-right sweep"
      }
    },
    {
      "name": "SideNavigation",
      "type": "navigation",
      "description": "侧边栏导航（平板/桌面）",
      "states": ["collapsed_icons", "expanded_with_labels"],
      "sections": [
        { "id": "home", "label": "主页", "icon": "grid" },
        { "id": "devices", "label": "设备", "icon": "cpu" },
        { "id": "scenes", "label": "场景", "icon": "zap" },
        { "id": "energy", "label": "能耗", "icon": "bar-chart-2" },
        { "id": "settings", "label": "设置", "icon": "settings" }
      ],
      "visual_spec": {
        "active_item": "bg brand/10 + left border 3px brand",
        "collapse_animation": "width transition 300ms ease"
      }
    },
    {
      "name": "BottomNavigation",
      "type": "navigation",
      "description": "底部导航（移动端）",
      "tabs": ["主页", "设备", "场景", "能耗"],
      "voice_fab": "悬浮语音按钮，中心位置，突出于导航条",
      "visual_spec": {
        "background": "rgba(13,15,20,0.90) blur(20px)",
        "active_icon_color": "#4E9EFF",
        "fab_size": "56px",
        "fab_color": "linear-gradient(135deg, #4E9EFF, #7C3AED)"
      }
    }
  ]
}

{
  "design_system_name": "Ambient Dark Control — 鸿蒙智联中控设计系统",
  "version": "1.0",

  "color_tokens": {
    "background": {
      "primary": "#0D0F14",
      "secondary": "#161921",
      "tertiary": "#1C2030",
      "surface_glass": "rgba(255, 255, 255, 0.06)",
      "surface_glass_active": "rgba(255, 255, 255, 0.10)"
    },
    "brand": {
      "primary": "#4E9EFF",
      "primary_glow": "rgba(78, 158, 255, 0.25)",
      "warm_accent": "#FF8C42",
      "warm_glow": "rgba(255, 140, 66, 0.30)"
    },
    "semantic": {
      "success": "#34D399",
      "success_glow": "rgba(52, 211, 153, 0.25)",
      "warning": "#FBBF24",
      "danger": "#FF5C5C",
      "danger_glow": "rgba(255, 92, 92, 0.25)"
    },
    "device_glow": {
      "light": "#FFD700",
      "light_warm": "#FF9500",
      "climate": "#60A5FA",
      "security": "#34D399",
      "entertainment": "#A78BFA",
      "appliance": "#FB923C",
      "offline": "rgba(255, 255, 255, 0.15)"
    },
    "text": {
      "primary": "#F0F4FF",
      "secondary": "#8B9BB4",
      "tertiary": "#4A5568",
      "inverse": "#0D0F14"
    },
    "border": {
      "subtle": "rgba(255, 255, 255, 0.08)",
      "medium": "rgba(255, 255, 255, 0.12)",
      "active": "rgba(78, 158, 255, 0.40)"
    }
  },

  "typography": {
    "font_families": {
      "display": "'Space Grotesk', 'DM Sans', sans-serif",
      "body": "'Noto Sans SC', 'Inter', sans-serif",
      "mono": "'JetBrains Mono', monospace"
    },
    "scale": {
      "hero_number": { "size": "3.5rem", "weight": 700, "letter_spacing": "-0.02em" },
      "large_number": { "size": "2rem", "weight": 600 },
      "heading_1": { "size": "1.25rem", "weight": 600 },
      "heading_2": { "size": "1rem", "weight": 600 },
      "body": { "size": "0.875rem", "weight": 400 },
      "label": { "size": "0.75rem", "weight": 400, "letter_spacing": "0.02em" },
      "caption": { "size": "0.6875rem", "weight": 400 }
    },
    "tabular_nums": true
  },

  "spacing": {
    "card_padding": "16px 20px",
    "card_gap": "12px",
    "section_gap": "24px",
    "section_padding": "20px",
    "large_section_gap": "32px"
  },

  "radius": {
    "card": "20px",
    "button": "10px",
    "chip": "full",
    "switch": "full",
    "input": "12px",
    "modal": "24px"
  },

  "elevation": {
    "card": "0 4px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255,255,255,0.08)",
    "card_active": "0 8px 40px rgba(0, 0, 0, 0.5)",
    "modal": "0 20px 60px rgba(0, 0, 0, 0.6)",
    "glow_light": "0 0 20px rgba(255, 215, 0, 0.30)",
    "glow_climate": "0 0 20px rgba(96, 165, 250, 0.30)",
    "glow_security": "0 0 20px rgba(52, 211, 153, 0.30)"
  },

  "blur": {
    "card": "backdrop-filter: blur(16px)",
    "overlay": "backdrop-filter: blur(24px)",
    "heavy": "backdrop-filter: blur(40px)"
  },

  "motion": {
    "switch_toggle": "180ms ease-out",
    "card_hover": "150ms ease",
    "scene_trigger_stagger": "80ms",
    "scene_trigger_total": "600-1200ms",
    "drawer_slide": "280ms cubic-bezier(0.32, 0.72, 0, 1)",
    "chart_entrance": "800ms ease-out stagger(100ms)",
    "toast_in": "240ms cubic-bezier(0.34, 1.56, 0.64, 1)",
    "toast_out": "160ms ease-in",
    "page_transition": "320ms ease-in-out",
    "number_count": "600ms ease-out",
    "glow_pulse": "2000ms ease-in-out infinite",
    "skeleton_shimmer": "1500ms linear infinite"
  },

  "device_type_config": {
    "lighting": {
      "icon_active_color": "#FFD700",
      "glow_color": "rgba(255, 215, 0, 0.30)",
      "controls": ["toggle", "brightness_slider"],
      "unit": "lm"
    },
    "climate": {
      "icon_active_color": "#60A5FA",
      "glow_color": "rgba(96, 165, 250, 0.30)",
      "controls": ["toggle", "temperature_spinner", "mode_chips"],
      "unit": "°C"
    },
    "security": {
      "icon_active_color": "#34D399",
      "glow_color": "rgba(52, 211, 153, 0.25)",
      "controls": ["toggle", "status_indicator"],
      "unit": null
    },
    "entertainment": {
      "icon_active_color": "#A78BFA",
      "glow_color": "rgba(167, 139, 250, 0.30)",
      "controls": ["toggle", "volume_slider"],
      "unit": null
    },
    "curtain": {
      "icon_active_color": "#FB923C",
      "glow_color": "rgba(251, 146, 60, 0.25)",
      "controls": ["toggle", "position_slider"],
      "unit": "%"
    },
    "appliance": {
      "icon_active_color": "#F9A8D4",
      "glow_color": "rgba(249, 168, 212, 0.25)",
      "controls": ["toggle", "mode_chips"],
      "unit": null
    }
  },

  "scene_config": {
    "home": {
      "label": "回家",
      "color_primary": "#FF8C42",
      "color_bg": "rgba(255, 140, 66, 0.10)",
      "icon": "home",
      "affected_device_types": ["lighting", "climate", "appliance"]
    },
    "away": {
      "label": "离家",
      "color_primary": "#4E9EFF",
      "color_bg": "rgba(78, 158, 255, 0.10)",
      "icon": "lock",
      "affected_device_types": ["security", "appliance"]
    },
    "sleep": {
      "label": "睡眠",
      "color_primary": "#A78BFA",
      "color_bg": "rgba(167, 139, 250, 0.10)",
      "icon": "moon",
      "affected_device_types": ["lighting", "climate", "curtain"]
    },
    "cinema": {
      "label": "观影",
      "color_primary": "#F59E0B",
      "color_bg": "rgba(245, 158, 11, 0.10)",
      "icon": "film",
      "affected_device_types": ["lighting", "entertainment", "curtain"]
    }
  },

  "breakpoints": {
    "mobile": "max-width: 767px",
    "tablet": "768px - 1199px",
    "desktop": "min-width: 1200px"
  },

  "layout_config": {
    "mobile": {
      "nav_position": "bottom",
      "device_grid_cols": 2,
      "scene_layout": "horizontal_scroll",
      "sidebar": false
    },
    "tablet": {
      "nav_position": "left_sidebar",
      "device_grid_cols": 2,
      "scene_layout": "vertical_list_in_sidebar",
      "sidebar_width": "220px"
    },
    "desktop": {
      "nav_position": "left_sidebar",
      "device_grid_cols": 3,
      "layout_columns": 3,
      "sidebar_width": "260px",
      "right_panel_width": "340px"
    }
  }
}

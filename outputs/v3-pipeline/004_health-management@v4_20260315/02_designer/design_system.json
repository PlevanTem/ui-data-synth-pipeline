{
  "colors": {
    "background": {
      "base": "#FDFCFB",
      "surface": "rgba(255, 255, 255, 0.7)",
      "surface_hover": "rgba(255, 255, 255, 0.9)"
    },
    "text": {
      "primary": "#2D3748",
      "secondary": "#718096",
      "accent": "#4A5568",
      "elderly_primary": "#1A202C"
    },
    "status": {
      "healthy": "#48BB78",
      "warning": "#ED8936",
      "danger": "#F56565",
      "sleep": "#805AD5",
      "heart": "#FC8181",
      "oxygen": "#4299E1",
      "activity": "#38B2AC"
    },
    "gradients": {
      "hero_bg": "linear-gradient(135deg, #EBF8FF 0%, #E6FFFA 50%, #F0FFF4 100%)",
      "warning_bg": "linear-gradient(135deg, #FFFAF0 0%, #FFEDD5 100%)"
    }
  },
  "typography": {
    "font_family": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "scales": {
      "normal": {
        "h1": "2.5rem",
        "h2": "1.75rem",
        "h3": "1.25rem",
        "body": "1rem",
        "small": "0.875rem"
      },
      "elderly": {
        "h1": "3rem",
        "h2": "2.25rem",
        "h3": "1.75rem",
        "body": "1.5rem",
        "small": "1.25rem"
      }
    },
    "weights": {
      "normal": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "spacing": {
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem"
  },
  "border_radius": {
    "md": "12px",
    "lg": "24px",
    "full": "9999px"
  },
  "shadows": {
    "soft": "0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01)",
    "glow": "0 0 20px rgba(72, 187, 120, 0.2)"
  }
}
{
  "design_direction": "治愈系自然数据雕塑 (Healing Natural Data)",
  "color_palette": {
    "background": "#FDFBF7",
    "surface": "#FFFFFF",
    "primary": "#E4895C",
    "secondary": "#6BA292",
    "text_primary": "#2D3142",
    "text_secondary": "#747C84",
    "alert_warm": "#E65F5C",
    "success_calm": "#4CAF50"
  },
  "typography": {
    "font_family": "Inter, system-ui, sans-serif",
    "headings": {
      "weight": "600",
      "scale": ["1.5rem", "1.75rem", "2rem"]
    },
    "data_display": {
      "weight": "700",
      "font_variant": "tabular-nums"
    },
    "elder_mode_multiplier": 1.25
  },
  "spacing": {
    "base": "8px",
    "card_padding": "24px",
    "section_gap": "32px"
  },
  "radius": {
    "card": "24px",
    "button": "100px",
    "pill": "9999px"
  },
  "shadow": {
    "soft": "0 8px 30px rgba(0, 0, 0, 0.04)",
    "floating": "0 20px 40px rgba(0, 0, 0, 0.08)"
  },
  "motion": {
    "timing_functions": {
      "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
      "ease_out": "cubic-bezier(0.25, 0.8, 0.25, 1)",
      "breathing": "ease-in-out"
    },
    "duration_scale": {
      "fast": "200ms",
      "base": "400ms",
      "slow": "800ms",
      "breath": "3000ms"
    }
  },
  "generative_aesthetics": {
    "color_mapping": {
      "sleep": ["#4F518C", "#907AD6"],
      "heart_rate": ["#E4895C", "#F4B860"],
      "activity": ["#6BA292", "#98CE00"]
    },
    "density_range": "low",
    "noise_parameters": "smooth fluid motion, low turbulence",
    "motion_speed_range": "mapped to vital signs"
  },
  "responsive_rules": [
    "Mobile first, cards span 100% width on small screens.",
    "Max width constrained to 480px for mobile app feel on desktop."
  ],
  "accessibility_rules": [
    "WCAG AA contrast minimum for all text.",
    "Interactive elements must have 48x48px minimum touch target.",
    "Support prefers-reduced-motion to disable generative backgrounds."
  ]
}
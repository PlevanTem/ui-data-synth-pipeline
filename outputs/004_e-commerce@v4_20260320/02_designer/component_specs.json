{
  "components": [
    {
      "name": "TopNav",
      "purpose": "在搜索、图谱、结账区之间导航并显示全局状态入口",
      "variants": ["desktop", "mobile-drawer"],
      "states": ["default", "hover", "active", "focus", "disabled", "loading", "error", "empty"],
      "interaction_notes": ["点击锚点平滑滚动", "移动端菜单支持 Esc 与遮罩关闭"],
      "linkage": {
        "affects": ["SearchPanel", "GraphStage", "CheckoutWizard"],
        "affected_by": ["GlobalToast"],
        "shared_state": ["activeSection", "locale", "currency"]
      },
      "motion_notes": ["active indicator 滑动过渡", "drawer slide-in 320ms"],
      "responsive_notes": ["mobile 固定底部主操作", "desktop 顶部悬浮"]
    },
    {
      "name": "SearchPanel",
      "purpose": "承接语义输入并驱动筛选、排序、结果刷新",
      "variants": ["hero-search", "sticky-compact"],
      "states": ["default", "hover", "active", "focus", "disabled", "loading", "error", "empty"],
      "interaction_notes": ["输入时 debounce 300ms", "回车触发立即搜索"],
      "linkage": {
        "affects": ["FilterDrawer", "ResultList", "GraphStage"],
        "affected_by": ["TopNav"],
        "shared_state": ["query", "filters", "sortKey"]
      },
      "motion_notes": ["loading shimmer", "result count number ticker"],
      "responsive_notes": ["mobile 作为首屏主 CTA", "desktop 与筛选栏并列"]
    },
    {
      "name": "FilterDrawer",
      "purpose": "提供价格、发货地、信誉筛选并联动内容",
      "variants": ["bottom-sheet", "side-panel"],
      "states": ["default", "hover", "active", "focus", "disabled", "loading", "error", "empty"],
      "interaction_notes": ["应用与重置按钮必须可达", "筛选变化实时更新摘要"],
      "linkage": {
        "affects": ["GraphStage", "ResultList", "TrustDetailPanel"],
        "affected_by": ["SearchPanel"],
        "shared_state": ["filters", "filterSummary"]
      },
      "motion_notes": ["chip enter/exit", "panel spring close"],
      "responsive_notes": ["mobile 采用抽屉", "desktop 常驻侧栏"]
    },
    {
      "name": "GraphStage",
      "purpose": "以 WebGL 可视化展示商品-品牌-风险关系",
      "variants": ["full", "compact"],
      "states": ["default", "hover", "active", "focus", "disabled", "loading", "error", "empty"],
      "interaction_notes": ["支持缩放、拖拽、节点点击聚焦", "节点 hover 显示关系摘要"],
      "linkage": {
        "affects": ["ResultList", "TrustDetailPanel", "GlobalToast"],
        "affected_by": ["SearchPanel", "FilterDrawer"],
        "shared_state": ["selectedNode", "graphViewport", "highlightSet"]
      },
      "motion_notes": ["focus pulse", "edge fade transition"],
      "responsive_notes": ["mobile 使用全屏切换模式", "desktop 与列表并排"]
    },
    {
      "name": "ResultList",
      "purpose": "展示候选商品并支持排序、对比与详情联动",
      "variants": ["card", "dense-list"],
      "states": ["default", "hover", "active", "focus", "disabled", "loading", "error", "empty"],
      "interaction_notes": ["点击卡片更新图谱高亮", "支持排序重排动画"],
      "linkage": {
        "affects": ["GraphStage", "TrustDetailPanel", "CheckoutWizard"],
        "affected_by": ["SearchPanel", "FilterDrawer", "GraphStage"],
        "shared_state": ["selectedProduct", "sortKey"]
      },
      "motion_notes": ["layout transition", "hover elevation"],
      "responsive_notes": ["mobile 单列", "tablet 起双列"]
    },
    {
      "name": "CheckoutWizard",
      "purpose": "提供可访问分步结账流程",
      "variants": ["3-step", "review-only"],
      "states": ["default", "hover", "active", "focus", "disabled", "loading", "error", "empty"],
      "interaction_notes": ["字段校验即时反馈", "提交有 loading 与结果 toast"],
      "linkage": {
        "affects": ["GlobalToast", "OrderSummaryCard"],
        "affected_by": ["ResultList", "TopNav"],
        "shared_state": ["checkoutStep", "formData", "formErrors"]
      },
      "motion_notes": ["step transition", "error shake (reduced-motion 下替换为色块提示)"],
      "responsive_notes": ["mobile 固定底部提交按钮", "desktop 双栏步骤+摘要"]
    },
    {
      "name": "GlobalToast",
      "purpose": "跨模块反馈操作成功、错误与提示",
      "variants": ["success", "warning", "error", "info"],
      "states": ["default", "hover", "active", "focus", "disabled", "loading", "error", "empty"],
      "interaction_notes": ["自动消失 + 手动关闭", "可由任意关键操作触发"],
      "linkage": {
        "affects": ["TopNav", "CheckoutWizard"],
        "affected_by": ["SearchPanel", "GraphStage", "CheckoutWizard"],
        "shared_state": ["toastQueue"]
      },
      "motion_notes": ["slide-in + fade", "stacked offset"],
      "responsive_notes": ["mobile 底部堆叠", "desktop 右上角"]
    }
  ],
  "interaction_flows": [
    {
      "trigger": "用户输入语义搜索并提交",
      "source_component": "SearchPanel",
      "target_components": ["FilterDrawer", "ResultList", "GraphStage"],
      "state_changes": ["query 更新", "results 重算", "graph 高亮集合重建"],
      "animation": "result cards stagger-in + graph edge fade"
    },
    {
      "trigger": "用户选择筛选条件",
      "source_component": "FilterDrawer",
      "target_components": ["ResultList", "GraphStage", "TrustDetailPanel"],
      "state_changes": ["filters 更新", "candidateSet 缩小", "risk highlights 更新"],
      "animation": "chip transition + list layout animation"
    },
    {
      "trigger": "用户点击图谱节点",
      "source_component": "GraphStage",
      "target_components": ["ResultList", "TrustDetailPanel"],
      "state_changes": ["selectedNode 更新", "associatedProducts 重排", "trust details 切换"],
      "animation": "node pulse + detail panel crossfade"
    },
    {
      "trigger": "用户提交结账表单",
      "source_component": "CheckoutWizard",
      "target_components": ["GlobalToast", "OrderSummaryCard"],
      "state_changes": ["isSubmitting true/false", "submitResult success|error"],
      "animation": "button loading morph + toast slide"
    }
  ]
}

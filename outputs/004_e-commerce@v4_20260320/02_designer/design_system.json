{
  "design_direction": "Graph Frost Navigator",
  "color_palette": {
    "bg_base": "#0A0E17",
    "bg_elevated": "#111827",
    "glass_fill": "rgba(227, 238, 255, 0.10)",
    "glass_stroke": "rgba(255, 255, 255, 0.24)",
    "text_primary": "#E7EEF9",
    "text_secondary": "#A7B6CC",
    "accent_primary": "#62A8FF",
    "accent_success": "#3DD9A4",
    "accent_warning": "#F2B75D",
    "accent_danger": "#FF6B7D"
  },
  "typography": {
    "heading": {
      "family": "Inter",
      "weights": [600, 700],
      "tracking": "-0.01em"
    },
    "body": {
      "family": "Inter",
      "weights": [400, 500],
      "line_height": 1.55
    },
    "scale": {
      "h1": "clamp(1.6rem, 3.8vw, 2.8rem)",
      "h2": "clamp(1.25rem, 2.8vw, 1.9rem)",
      "body": "clamp(0.95rem, 1.8vw, 1rem)",
      "caption": "0.82rem"
    }
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 10,
    "md": 14,
    "lg": 20,
    "pill": 999
  },
  "shadow": {
    "glass": "0 10px 40px rgba(16, 33, 64, 0.35)",
    "focus": "0 0 0 2px rgba(98,168,255,0.45)",
    "float": "0 24px 64px rgba(0, 0, 0, 0.35)"
  },
  "motion": {
    "timing_functions": {
      "standard": "cubic-bezier(0.25, 0.1, 0.25, 1)",
      "emphasized": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "snappy": "cubic-bezier(0.3, 0, 0.2, 1)"
    },
    "duration_scale": {
      "micro": 180,
      "state": 260,
      "panel": 320,
      "graph_focus": 520
    },
    "orchestration_rules": [
      "前景交互先于背景反馈 60-100ms",
      "同一交互链最多三层动画叠加",
      "视图切换时保留用户上下文，不做全量重置"
    ],
    "scroll_animation_strategy": "section-based subtle parallax + intersection reveal; reduced-motion 下禁用位移动画"
  },
  "interaction_principles": [
    "每次状态变化都应有可见反馈（文本、图标或过渡）",
    "风险信息必须颜色+文案+图标双重表达",
    "触控目标最小 44px，移动端优先",
    "筛选、图谱、结果三者必须实时通信"
  ],
  "visual_motifs": [
    "frosted translucency",
    "semantic node constellations",
    "soft edge glow",
    "layered depth"
  ],
  "generative_aesthetics": {
    "color_mapping": {
      "idle": ["#1B263B", "#274C77"],
      "focus": ["#62A8FF", "#AEE3FF"],
      "risk": ["#FF6B7D", "#F2B75D"]
    },
    "density_range": {
      "particles_per_100k_px": [16, 32],
      "graph_nodes": [240, 1200]
    },
    "noise_parameters": {
      "flow_noise_scale": [0.0008, 0.0016],
      "flow_turbulence": [0.18, 0.32]
    },
    "motion_speed_range": {
      "background_flow": [0.12, 0.36],
      "focus_pulse": [0.8, 1.4]
    },
    "blend_modes": ["screen", "overlay"],
    "layer_opacity_strategy": "背景 0.25-0.4，中景图谱 0.65-0.95，前景内容 0.96-1"
  },
  "illustration_strategy": {
    "use": "lightweight line illustrations for trust explanations",
    "style": "semi-technical, low-saturation",
    "animation": "path reveal + node pulse"
  },
  "depth_strategy": {
    "layers": ["background flow", "graph canvas", "content glass", "overlay panels"],
    "z_index_scale": [0, 10, 20, 40, 80]
  },
  "responsive_rules": [
    "mobile 中图谱与列表使用 segmented view 切换",
    "tablet 起支持图谱 + 详情并列",
    "desktop 使用三栏密度布局且可固定筛选区"
  ],
  "accessibility_rules": [
    "正文对比度保持 >= 4.5:1",
    "icon-only 按钮必须有 aria-label",
    "error 文案使用 role=alert",
    "支持 keyboard navigation 与 visible focus",
    "尊重 prefers-reduced-motion"
  ]
}

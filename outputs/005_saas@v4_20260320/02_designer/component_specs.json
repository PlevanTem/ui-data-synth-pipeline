  "interaction_flows": [
    {
      "trigger": "选择高风险筛选",
      "source_component": "GlobalFilterBar",
      "target_components": [
        "TaskQueue",
        "GeoHeatmapPanel",
        "GenerativeFlowBackdrop"
      ],
      "state_changes": [
        "severity=high",
        "heat-intensity++",
        "flow-speed++"
      ],
      "animation": "filter chip pulse + cards reorder"
    },
    {
      "trigger": "点击白板节点",
      "source_component": "WhiteboardCanvas",
      "target_components": [
        "SecureChatPanel",
        "DecisionSnapshotModal"
      ],
      "state_changes": [
        "activeThread=linked",
        "snapshotSource=selectedNode"
      ],
      "animation": "thread panel slide-in"
    },
    {
      "trigger": "提交报表计划",
      "source_component": "ReportSchedulerForm",
      "target_components": [
        "ReportRunTimeline",
        "ToastCenter"
      ],
      "state_changes": [
        "form=loading->success",
        "timeline.append(run)"
      ],
      "animation": "button morph + success toast"
    }
  ]
}

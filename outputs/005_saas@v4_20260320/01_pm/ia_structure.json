  "critical_flows": [
    {
      "flow_name": "跨模块聚焦决策流",
      "steps": [
        "选择时间/区域筛选",
        "查看聚焦队列",
        "打开白板讨论",
        "在聊天线程确认",
        "生成决策快照"
      ],
      "success_condition": "用户在单次流程中完成发现问题→协作讨论→沉淀结论，且信息来源可追溯。"
    },
    {
      "flow_name": "报表自动化配置流",
      "steps": [
        "选择模板",
        "配置指标",
        "设置推送频率与接收者",
        "提交并查看最近执行结果"
      ],
      "success_condition": "任务提交后有明确的下一次执行时间与可查看的运行日志。"
    },
    {
      "flow_name": "地理异常响应流",
      "steps": [
        "地图筛选高风险区域",
        "查看热点事件详情",

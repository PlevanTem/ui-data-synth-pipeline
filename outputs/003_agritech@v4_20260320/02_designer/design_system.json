{
  "design_direction": "GeoPulse Tech Field",
  "color_palette": {
    "bg_base": "#060C18",
    "bg_panel": "#0F1B31",
    "bg_elevated": "#152542",
    "text_primary": "#EAF2FF",
    "text_secondary": "#9DB0CC",
    "accent_primary": "#2AA8FF",
    "accent_secondary": "#1EE3CF",
    "warning": "#F59E0B",
    "danger": "#F87171",
    "success": "#34D399",
    "border": "#2A3B5F"
  },
  "typography": {
    "heading_family": "Fira Code, Inter, system-ui, sans-serif",
    "body_family": "Fira Sans, Inter, system-ui, sans-serif",
    "line_height_body": 1.55
  },
  "spacing": {
    "section_y": 88,
    "grid_gap": 24,
    "card_padding": 20
  },
  "radius": {
    "sm": 10,
    "md": 14,
    "lg": 20,
    "pill": 999
  },
  "shadow": {
    "panel": "0 10px 36px rgba(0, 0, 0, 0.35)",
    "focus": "0 0 0 2px rgba(42, 168, 255, 0.55)"
  },
  "motion": {
    "timing_functions": {
      "standard": "cubic-bezier(0.22, 1, 0.36, 1)",
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "duration_scale": {
      "micro": 180,
      "base": 260,
      "complex": 420
    },
    "orchestration_rules": [
      "同屏主运动不超过3组",
      "先局部反馈后全局反馈",
      "地图与图表动效节奏保持同步"
    ],
    "scroll_animation_strategy": "section reveal + KPI threshold pulses"
  },
  "interaction_principles": [
    "关键交互必须有即时和结果双反馈",
    "筛选状态可见且可撤销",
    "图表、地图、工作流共享核心状态"
  ],
  "visual_motifs": ["flow field", "pulse ring", "route trace", "geo grid", "command node"],
  "generative_aesthetics": {
    "color_mapping": {
      "low_signal": "#1C3E70",
      "mid_signal": "#2AA8FF",
      "hot_signal": "#1EE3CF",
      "risk_signal": "#F59E0B"
    },
    "density_range": {
      "desktop_particles": [120, 220],
      "mobile_particles": [50, 100]
    },
    "noise_parameters": {
      "scale": [0.002, 0.005],
      "time_step": [0.003, 0.008]
    },
    "motion_speed_range": {
      "ambient": [0.2, 0.5],
      "interaction_boost": [0.7, 1.2]
    },
    "blend_modes": ["screen", "soft-light"],
    "layer_opacity_strategy": "background<=0.3, interactive overlays<=0.5"
  },
  "illustration_strategy": {
    "style": "schematic geo-operations",
    "usage": "只在解释复杂流程时出现，避免装饰化堆叠"
  },
  "depth_strategy": {
    "layers": ["background atmosphere", "content surfaces", "interactive overlays", "feedback layer"],
    "z_index_scale": [0, 10, 20, 50]
  },
  "responsive_rules": [
    "mobile 首先保证筛选、地图点选与 CTA 提交可用",
    "tablet 保持图表与地图并列可读",
    "desktop 保留完整三模块联动与高密度信息"
  ],
  "accessibility_rules": [
    "WCAG AA 对比度基线",
    "键盘焦点态全局可见",
    "遵循 prefers-reduced-motion",
    "地图和图表需有文本补充说明"
  ]
}
